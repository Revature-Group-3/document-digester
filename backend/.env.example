# Copy this file to backend/.env and fill in the values.
# backend/.env is gitignored, so your real credentials stay local.

# Required. Postgres connection used by SQL search.
# Vector and hybrid search work with a placeholder value.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/document_digester

# Optional. Leave unset to use the defaults:
#   EMBEDDING_MODEL           all-minilm
#   DOCS_DIR                  the repo's docs/ folder
#   CHROMA_PERSIST_DIRECTORY  backend/data/chroma
